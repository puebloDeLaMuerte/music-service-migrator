# Byte-compiled / optimized
__pycache__/
*.py[codz]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets
.env
.envrc

# Spotipy OAuth token cache
.cache

# IDE
.idea/
.vscode/
*.swp
*.swo

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/

# Mypy / Ruff
.mypy_cache/
.ruff_cache/

# Output from tools
output*/
# Workspace / local library (WORK_DIR in .env; default ./work)
work/
workspot/
logs/
playlists/
backups/

# Auth caches under any WORK_DIR inside the repo (do not commit)
**/meta/spotify_token.json
**/meta/tidal_session.json

# OS junk
.DS_Store
Thumbs.db

# Cursor
.cursorignore
.cursorindexingignore
